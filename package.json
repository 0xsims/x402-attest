{
  "name": "x402-attest-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Attesting x402 client SDK — tamper-evident receipts for agent-paid HTTP calls",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "workspaces": [
    "packages/x402-attest",
    "packages/clawrouter-attest",
    "packages/verify-cli"
  ],
  "scripts": {
    "build": "tsc -b packages/x402-attest packages/clawrouter-attest packages/verify-cli",
    "clean": "rm -rf packages/*/dist packages/*/*.tsbuildinfo coverage",
    "typecheck": "tsc -b --pretty packages/x402-attest packages/clawrouter-attest packages/verify-cli",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "coverage": "npm run build && X402_ATTEST_SKIP_PERF=1 vitest run --coverage",
    "example": "npm run build --silent && node examples/keyless-e2e.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@vitest/coverage-v8": "^2.1.9",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
